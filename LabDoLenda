    lbl(notif, title, UDim2.new(1,-20,0,25), UDim2.new(0,10,0,5), 13, C.ACC2, Enum.TextXAlignment.Left)
    local msgL = lbl(notif, msg, UDim2.new(1,-20,0,35), UDim2.new(0,10,0,30), 11, C.TEXT, Enum.TextXAlignment.Left)
    msgL.TextWrapped = true; notif.Parent = screenParent
    tween(notif, {Position=UDim2.new(1,-320,0,80)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
