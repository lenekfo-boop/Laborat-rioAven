    b.Font=Enum.Font.GothamBold; b.TextColor3=C.WHITE; b.AutoButtonColor=false; b.LayoutOrder=lo or 99; b.ZIndex=2
    corner(b,7); stroke(b,C.BORDER,1)
    b.MouseEnter:Connect(function() tween(b,{BackgroundTransparency=0.25},0.1) end)
    b.MouseLeave:Connect(function() tween(b,{BackgroundTransparency=0},0.1) end)
    if cb then b.MouseButton1Click:Connect(cb) end
    return b
