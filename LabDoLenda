local function togBtn(parent, offTxt, onTxt, offCol, onCol, lo, cb)
    local state=false
    local b=actBtn(parent, offTxt, offCol, lo)
    b.MouseButton1Click:Connect(function()
        state=not state; b.Text=state and onTxt or offTxt
        tween(b,{BackgroundColor3=state and onCol or offCol},0.15)
        if cb then cb(state) end
    end)
    return b, function() return state end
end

